---
---

<header class="header">
	<div class="container header__inner">
		<a class="header__brand" href="/">
			pásamelo<span class="header__brand-suffix">.es</span>
		</a>
		<nav aria-label="Principal">
			<ul class="header__nav">
				<li><a href="/#mensajes">Mensajes</a></li>
				<li><a href="https://www.pasamelo.es/correo/correo.html">Envía el tuyo</a></li>
			</ul>
		</nav>
	</div>
</header>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 30;
		background-color: color-mix(in oklab, var(--background) 90%, transparent);
		border-bottom: 1px solid color-mix(in oklab, var(--border) 80%, transparent);
		backdrop-filter: blur(12px);
	}

	.header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--radius-lg);
		padding-block: 0.75rem;
	}

	.header__brand {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 800;
		letter-spacing: -0.025em;
		transition: opacity 180ms ease;
	}

	@media (min-width: 640px) {
		.header__brand {
			font-size: 1.5rem;
		}
	}

	.header__brand:hover {
		opacity: 0.8;
	}

	.header__brand-suffix {
		color: var(--primary);
	}

	.header__nav {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.875rem;
		font-weight: 500;
	}

	.header__nav a {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		padding: 0.5rem 0.75rem;
		border-radius: var(--radius-md);
		transition: background-color 180ms ease;
	}

	.header__nav a:hover {
		background-color: var(--secondary);
	}

	/* El CTA de color primario se oculta antes que el resto en pantallas
	   pequeñas, siguiendo el patrón de v0 (hidden sm:block). */
	.header__nav li:last-child a {
		display: none;
		background-color: var(--primary);
		color: var(--primary-foreground);
		font-weight: 500;
	}

	.header__nav li:last-child a:hover {
		opacity: 0.9;
	}

	@media (min-width: 640px) {
		.header__nav {
			gap: 0.5rem;
		}

		.header__nav li:last-child a {
			display: inline-flex;
		}
	}
</style>