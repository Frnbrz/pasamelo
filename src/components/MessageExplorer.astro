---
import { getCollection } from 'astro:content';
import MessageActions from './MessageActions.astro';
import { ordenar, parseMensajes } from '../lib/mensajes';

const categorias = ordenar(await getCollection('mensajes'));

const grupos = categorias.reduce<Map<string, { titulo: string; categorias: typeof categorias }>>(
	(mapa, categoria) => {
		const { grupo, grupoTitulo } = categoria.data;
		if (!mapa.has(grupo)) mapa.set(grupo, { titulo: grupoTitulo, categorias: [] });
		mapa.get(grupo)!.categorias.push(categoria);
		return mapa;
	},
	new Map(),
);

const lista = [...grupos.values()];

const mensajes = categorias.flatMap((categoria) =>
	parseMensajes(categoria.body).map((texto) => ({
		id: `${categoria.id}-${texto}`,
		texto,
		categoria: categoria.data.titulo,
		slug: categoria.id,
	})),
);
---

<section id="mensajes" class="explorer">
	<div class="container">
		<header class="explorer__head">
			<h2 class="explorer__title">¿Qué quieres decir?</h2>
			<p class="explorer__lead">
				Elige una ocasión o busca por palabra. Todos los mensajes están listos para copiar y
				enviar.
			</p>
		</header>

		<div class="explorer__layout">
			<aside class="explorer__aside" aria-label="Categorías">
				<div class="explorer__panel">
					<label class="explorer__search">
						<span class="visually-hidden">Buscar mensajes</span>
						<svg
							class="explorer__search-icon"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							aria-hidden="true"
							focusable="false"
						>
							<circle cx="11" cy="11" r="7"></circle>
							<path d="m20 20-3.5-3.5"></path>
						</svg>
						<input
							type="search"
							placeholder="Busca: abrazo, tarta, mamá…"
							autocomplete="off"
							data-buscar
						/>
					</label>

					<nav class="chips" aria-label="Filtrar por categoría">
						<button class="chip chip--todos" type="button" aria-pressed="true" data-categoria="">
							Todos los mensajes
						</button>

						{
							lista.map((grupo) => (
								<div class="chip__group">
									<h3 class="chip__group-title">{grupo.titulo}</h3>
									{grupo.categorias.map((categoria) => (
										<button
											class="chip"
											type="button"
											aria-pressed="false"
											data-categoria={categoria.id}
										>
											{categoria.data.titulo}
										</button>
									))}
								</div>
							))
						}
					</nav>
				</div>
			</aside>

			<div class="explorer__results">
				<div class="explorer__toolbar">
					<p class="explorer__count" aria-live="polite" data-conteo>
						{mensajes.length} mensajes
					</p>
					<button class="surprise" type="button" data-sorprendeme>
						<svg
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
							focusable="false"
						>
							<path d="M16 3h5v5"></path>
							<path d="M4 20 21 3"></path>
							<path d="M21 16v5h-5"></path>
							<path d="m15 15 6 6"></path>
							<path d="M4 4l5 5"></path>
						</svg>
						Sorpréndeme
					</button>
				</div>

				<ul class="grid" data-lista>
					{
						mensajes.map((mensaje) => (
							<li class="card" id={`msg-${mensaje.slug}-${mensaje.texto.slice(0, 24).replace(/\s+/g, '-')}`} data-slug={mensaje.slug}>
								<span class="card__label">{mensaje.categoria}</span>
								<p class="card__text">{mensaje.texto}</p>
								<MessageActions text={mensaje.texto} />
							</li>
						))
					}
				</ul>

				<div class="empty" data-vacio hidden>
					<p class="empty__title">No hay mensajes con esa palabra</p>
					<p class="empty__lead">Prueba con otra o elige una categoría.</p>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.explorer {
		scroll-margin-top: 5rem;
		background-color: var(--paper);
		border-top: 1px solid var(--border);
	}

	.explorer > .container {
		padding-block: 4rem;
	}

	@media (min-width: 768px) {
		.explorer > .container {
			padding-block: 5rem;
		}
	}

	.explorer__head {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding-bottom: 2rem;
	}

	@media (min-width: 768px) {
		.explorer__head {
			padding-bottom: 2.5rem;
		}
	}

	.explorer__title {
		font-family: var(--font-display);
		font-size: clamp(2.25rem, 1.4rem + 2.4vw, 3rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}

	.explorer__lead {
		max-width: 36rem;
		color: var(--muted-foreground);
		line-height: 1.625;
	}

	.explorer__layout {
		display: grid;
		gap: 2.5rem;
	}

	@media (min-width: 1024px) {
		.explorer__layout {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			gap: 0;
		}
	}

	.explorer__aside {
		min-width: 0;
	}

	@media (min-width: 1024px) {
		.explorer__aside {
			grid-column: span 4 / span 4;
			padding-right: 2rem;
		}
	}

	@media (min-width: 1280px) {
		.explorer__aside {
			grid-column: span 3 / span 3;
		}
	}

	.explorer__panel {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	@media (min-width: 1024px) {
		.explorer__panel {
			position: sticky;
			top: 6rem;
			max-height: calc(100dvh - 8rem);
			overflow-y: auto;
			padding-bottom: 1rem;
		}
	}

	.explorer__search {
		position: relative;
		display: block;
	}

	.explorer__search-icon {
		position: absolute;
		top: 50%;
		left: 0.75rem;
		transform: translateY(-50%);
		color: var(--muted-foreground);
		pointer-events: none;
	}

	.explorer__search input {
		width: 100%;
		min-height: 3.25rem;
		padding: 0.875rem 0.75rem 0.875rem 2.5rem;
		background-color: var(--background);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		box-shadow: 0 1px 2px rgb(0 0 0 / 5%);
		transition: box-shadow 180ms ease;
	}

	.explorer__search input::placeholder {
		color: var(--muted-foreground);
	}

	.explorer__search input:focus-visible {
		box-shadow: 0 0 0 2px var(--ring);
	}

	/* Categorías: fila desplazable en móvil, columna agrupada en escritorio */
	.chips {
		display: flex;
		gap: 0.5rem;
		overflow-x: auto;
		padding-bottom: 0.5rem;
	}

	@media (min-width: 1024px) {
		.chips {
			flex-direction: column;
			gap: 1.5rem;
			overflow: visible;
			padding-bottom: 0;
		}
	}

	.chip__group {
		display: flex;
		flex-shrink: 0;
		gap: 0.5rem;
	}

	@media (min-width: 1024px) {
		.chip__group {
			flex-direction: column;
			gap: 0.25rem;
		}
	}

	.chip__group-title {
		display: none;
	}

	@media (min-width: 1024px) {
		.chip__group-title {
			display: block;
			padding: 0 0.75rem 0.25rem;
			color: var(--muted-foreground);
			font-size: 0.75rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.1em;
		}
	}

	.chip {
		flex-shrink: 0;
		min-height: 2.75rem;
		padding: 0.625rem 0.875rem;
		border-radius: var(--radius-lg);
		width: 100%;
		font-size: 0.875rem;
		white-space: nowrap;
		transition:
			background-color 180ms ease,
			color 180ms ease;
	}

	@media (min-width: 1024px) {
		.chip {
			align-self: flex-start;
			white-space: normal;
			text-align: left;
		}
	}

	.chip:hover {
		background-color: var(--secondary);
	}

	.chip[aria-pressed='true'] {
		background-color: var(--highlight);
		color: var(--accent-foreground);
		border-color: transparent;
		font-weight: 600;
	}

	.chip--todos {
		align-self: flex-start;
	}

	.explorer__results {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		min-width: 0;
	}

	@media (min-width: 1024px) {
		.explorer__results {
			grid-column: span 8 / span 8;
		}
	}

	@media (min-width: 1280px) {
		.explorer__results {
			grid-column: span 9 / span 9;
		}
	}

	.explorer__toolbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.explorer__count {
		color: var(--muted-foreground);
		font-size: 0.875rem;
	}

	.surprise {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		/* v0 usa min-h-10 (40px); DESIGN.md exige 44px como área táctil mínima. */
		min-height: 2.75rem;
		padding: 0.5rem 0.75rem;
		background-color: var(--background);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		font-size: 0.875rem;
		font-weight: 600;
		transition:
			transform 180ms ease,
			background-color 180ms ease;
	}

	.surprise:hover {
		transform: translateY(-2px);
		background-color: var(--secondary);
	}

	.grid {
		display: grid;
		align-items: start;
		gap: 1.5rem;
	}

	@media (min-width: 768px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.card {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		scroll-margin-top: 6rem;
		padding: 1.5rem;
		background-color: var(--background);
		border: 1px solid var(--border);
		border-radius: var(--radius-xl);
		box-shadow: 0 1px 2px rgb(0 0 0 / 5%);
		transition:
			box-shadow 180ms ease,
			border-color 180ms ease;
	}

	@media (min-width: 768px) {
		.card {
			padding: 1.75rem;
		}
	}

	.card:hover {
		box-shadow: 0 4px 12px rgb(0 0 0 / 8%);
	}

	.card[data-destacada] {
		border-color: var(--primary);
		box-shadow: 0 8px 24px rgb(0 0 0 / 12%);
		outline: 2px solid var(--highlight);
	}

	.card__label {
		color: var(--muted-foreground);
		font-size: 0.875rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	.card__text {
		line-height: 1.75;
		text-wrap: pretty;
	}

	.empty {
		padding: 2.5rem;
		border: 1px dashed var(--border);
		border-radius: var(--radius-lg);
		text-align: center;
	}

	.empty__title {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 600;
	}

	.empty__lead {
		padding-top: 0.5rem;
		color: var(--muted-foreground);
	}
</style>

<script>
	const normalizar = (valor: string) =>
		valor
			.normalize('NFD')
			.replace(/[\u0300-\u036f]/g, '')
			.toLowerCase();

	const lista = document.querySelector<HTMLElement>('[data-lista]');
	const vacio = document.querySelector<HTMLElement>('[data-vacio]');
	const conteo = document.querySelector<HTMLElement>('[data-conteo]');
	const campo = document.querySelector<HTMLInputElement>('[data-buscar]');
	const botones = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-categoria]'));

	if (lista && campo) {
		const entrada = campo;
		const tarjetas = Array.from(lista.querySelectorAll<HTMLElement>('.card'));

		// Solo el texto del mensaje y el nombre de la categoría son buscables:
		// incluir el texto de los botones haría que "copiar" coincidiera con todo.
		const indice = new Map(
			tarjetas.map((tarjeta) => [
				tarjeta,
				normalizar(
					`${tarjeta.querySelector('.card__label')?.textContent ?? ''} ${
						tarjeta.querySelector('.card__text')?.textContent ?? ''
					}`,
				),
			]),
		);

		const seccion = document.getElementById('mensajes');
		let categoriaActiva = '';
		let destacada: HTMLElement | null = null;

		function limpiarResaltado() {
			if (!destacada) return;
			destacada.removeAttribute('data-destacada');
			destacada = null;
		}

		function filtrar() {
			const termino = normalizar(entrada.value.trim());
			const visibles: HTMLElement[] = [];

			for (const tarjeta of tarjetas) {
				const coincide =
					(categoriaActiva === '' || tarjeta.dataset.slug === categoriaActiva) &&
					(termino === '' || (indice.get(tarjeta) ?? '').includes(termino));
				tarjeta.hidden = !coincide;
				if (coincide) visibles.push(tarjeta);
			}

			if (vacio) vacio.hidden = visibles.length > 0;
			if (conteo) {
				const nombre = botones.find((b) => b.dataset.categoria === categoriaActiva)?.textContent?.trim();
				conteo.textContent = `${visibles.length} ${visibles.length === 1 ? 'mensaje' : 'mensajes'}${
					categoriaActiva ? ` de ${nombre}` : ''
				}`;
			}
		}

		function seleccionar(id: string) {
			categoriaActiva = id;
			limpiarResaltado();
			for (const boton of botones) {
				boton.setAttribute('aria-pressed', String(boton.dataset.categoria === id));
			}
			filtrar();

			if (seccion && seccion.getBoundingClientRect().top < 0) {
				seccion.scrollIntoView({ block: 'start' });
			}
		}

		for (const boton of botones) {
			boton.addEventListener('click', () => seleccionar(boton.dataset.categoria ?? ''));
		}

		entrada.addEventListener('input', filtrar);

		document.querySelector('[data-sorprendeme]')?.addEventListener('click', () => {
			const visibles = tarjetas.filter((tarjeta) => !tarjeta.hidden);
			const grupo = visibles.length > 0 ? visibles : tarjetas;
			const elegida = grupo[Math.floor(Math.random() * grupo.length)];
			if (!elegida) return;

			limpiarResaltado();
			elegida.setAttribute('data-destacada', '');
			destacada = elegida;
			elegida.scrollIntoView({ block: 'center' });
		});

		filtrar();
	}
</script>
