---
const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="container footer__inner">
		<div class="footer__cta">
			<p class="footer__title">¿Tienes un mensaje mejor?</p>
			<p class="footer__lead">
				Mándanoslo y, si nos gusta, lo pasamos a todo el mundo.
			</p>
			<a class="footer__button" href="https://www.pasamelo.es/correo/correo.html">
				<svg
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
					focusable="false"
				>
					<rect x="3" y="5" width="18" height="14" rx="2"></rect>
					<path d="m3 7 9 6 9-6"></path>
				</svg>
				Escríbenos
			</a>
		</div>

		<div class="footer__meta">
			<p class="footer__brand">pásamelo.es</p>
			<p>Por Francisco Briz Hidalgo</p>
			<p>© {year} · Mensajes cortos para móvil, WhatsApp y redes</p>
		</div>
	</div>
</footer>

<style>
	.footer {
		background-color: var(--primary);
		color: var(--primary-foreground);
	}

	.footer__inner {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		padding-block: 3.5rem;
	}

	@media (min-width: 768px) {
		.footer__inner {
			flex-direction: row;
			align-items: flex-end;
			justify-content: space-between;
		}
	}

	.footer__cta {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.footer__title {
		font-family: var(--font-display);
		font-size: clamp(2.25rem, 1.4rem + 2.6vw, 3.75rem);
		font-weight: 800;
		letter-spacing: -0.03em;
	}

	.footer__lead {
		max-width: 28rem;
		line-height: 1.625;
		opacity: 0.8;
	}

	.footer__button {
		display: inline-flex;
		align-items: center;
		align-self: flex-start;
		gap: 0.5rem;
		min-height: 2.75rem;
		padding: 0.75rem 1.25rem;
		background-color: var(--highlight);
		color: var(--accent-foreground);
		border-radius: var(--radius-md);
		font-weight: 600;
		transition: opacity 180ms ease;
	}

	.footer__button:hover {
		opacity: 0.9;
	}

	.footer__meta {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		font-size: 0.875rem;
		opacity: 0.8;
	}

	@media (min-width: 768px) {
		.footer__meta {
			text-align: right;
		}
	}

	.footer__brand {
		font-family: var(--font-display);
		font-size: 1.125rem;
		font-weight: 700;
		opacity: 1;
	}
</style>